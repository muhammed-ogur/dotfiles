# ~/dotfiles/.bashrc_ek - kisisel bash eklerim (~/.bashrc bu dosyayi okur)

# --- ssh-agent: tum terminaller tek agent'i paylassin ---
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
    rm -f "$SSH_AUTH_SOCK"
    eval "$(ssh-agent -s -a "$SSH_AUTH_SOCK")" >/dev/null
fi
